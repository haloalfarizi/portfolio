---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[#0C0C0C]/10 py-12 mt-20 relative bg-[#0C0C0C] text-[#F8F8FF]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-2.5">
      <div class="w-6 h-6 rounded-md bg-[#F9452D] flex items-center justify-center font-bold text-white text-xs shadow-sm">
        A
      </div>
      <p class="text-sm text-[#F8F8FF]/70">
        &copy; {currentYear} Alfarizi. Built with Astro, Tailwind & Framer Motion.
      </p>
    </div>

    <div class="flex items-center gap-6 text-sm text-[#F8F8FF]/70">
      <a href="https://github.com/haloalfarizi" target="_blank" rel="noreferrer" class="hover:text-[#F9452D] transition-colors">
        GitHub
      </a>
      <a href="https://twitter.com" target="_blank" rel="noreferrer" class="hover:text-[#F9452D] transition-colors">
        Twitter
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noreferrer" class="hover:text-[#F9452D] transition-colors">
        LinkedIn
      </a>
      <a href="mailto:hello@alfarizi.dev" class="hover:text-[#F9452D] transition-colors">
        Email
      </a>
    </div>
  </div>
</footer>
