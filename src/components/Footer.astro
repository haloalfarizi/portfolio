---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-white/5 py-12 mt-20 relative bg-[#090d16]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded-md bg-indigo-600 flex items-center justify-center font-bold text-white text-xs">
        A
      </div>
      <p class="text-sm text-gray-400">
        &copy; {currentYear} Alfarizi. Built with Astro, Tailwind & Framer Motion.
      </p>
    </div>

    <div class="flex items-center gap-6 text-sm text-gray-400">
      <a href="https://github.com/haloalfarizi" target="_blank" rel="noreferrer" class="hover:text-white transition-colors">
        GitHub
      </a>
      <a href="https://twitter.com" target="_blank" rel="noreferrer" class="hover:text-white transition-colors">
        Twitter
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noreferrer" class="hover:text-white transition-colors">
        LinkedIn
      </a>
      <a href="mailto:hello@alfarizi.dev" class="hover:text-white transition-colors">
        Email
      </a>
    </div>
  </div>
</footer>
