---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");
const isHome = currentPath === "";

const navItems = [
  { name: "WORK ¹²", href: "/projects" },
  { name: "ABOUT", href: "/about" },
  { name: "CONTACT", href: "/contact" },
];
---

<header class={`w-full z-50 transition-all ${
  isHome 
    ? "absolute top-0 left-0 right-0 bg-transparent" 
    : "sticky top-0 glass-nav border-b border-[#0C0C0C]/5"
}`}>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-14 h-20 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-1 group">
      <span class={`font-black text-xl sm:text-2xl tracking-tighter uppercase ${
        isHome ? "text-white" : "text-[#0C0C0C]"
      }`}>
        AL-FARIZI<span class="text-xs font-semibold ml-0.5 text-[#F9452D]">®</span>
      </span>
    </a>

    <!-- Center Navigation Links -->
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => {
        const isActive = (item.href === "/" && currentPath === "") || (item.href !== "/" && currentPath === item.href);
        return (
          <a
            href={item.href}
            class={`text-xs font-bold tracking-widest uppercase transition-all ${
              isHome
                ? isActive
                  ? "text-white border-b-2 border-white pb-0.5"
                  : "text-white/75 hover:text-white"
                : isActive
                  ? "text-[#0C0C0C] border-b-2 border-[#0C0C0C] pb-0.5"
                  : "text-[#0C0C0C]/70 hover:text-[#F9452D]"
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Action Button: Capsule pill matching reference -->
    <div class="hidden md:flex items-center">
      <a
        href="/contact"
        class="inline-flex items-center gap-3 pl-5 pr-1.5 py-1.5 rounded-full bg-white text-[#0C0C0C] text-xs font-bold tracking-wide shadow-xl hover:bg-[#F8F8FF] hover:scale-105 transition-all group"
      >
        <span>Let's talk</span>
        <span class="w-7 h-7 rounded-full bg-[#0C0C0C] text-white flex items-center justify-center text-xs group-hover:bg-[#F9452D] group-hover:rotate-45 transition-all duration-300">
          &#8599;
        </span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class={`md:hidden p-2 rounded-lg focus:outline-none ${
        isHome ? "text-white hover:bg-white/10" : "text-[#0C0C0C] hover:bg-[#0C0C0C]/5"
      }`}
      aria-label="Toggle Navigation"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden px-6 pt-2 pb-6 space-y-3 bg-[#0C0C0C] text-white border-t border-white/10 shadow-2xl">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block py-2 text-sm font-bold tracking-widest uppercase text-white/80 hover:text-[#F9452D]"
      >
        {item.name}
      </a>
    ))}
    <a
      href="/contact"
      class="inline-flex w-full items-center justify-between px-5 py-3 rounded-full bg-white text-[#0C0C0C] text-xs font-bold"
    >
      <span>Let's talk</span>
      <span class="w-6 h-6 rounded-full bg-[#0C0C0C] text-white flex items-center justify-center text-xs">&#8599;</span>
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
