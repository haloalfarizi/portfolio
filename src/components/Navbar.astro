---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");

const navItems = [
  { name: "HOME", href: "/" },
  { name: "WORK ⁴", href: "/projects" },
  { name: "ABOUT", href: "/about" },
  { name: "CONTACT", href: "/contact" },
];
---

<header class="sticky top-0 z-50 w-full glass-nav transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <span class="font-extrabold text-lg sm:text-xl text-[#0C0C0C] tracking-tight flex items-baseline">
        AL-FARIZI<span class="text-xs font-semibold ml-0.5 text-[#F9452D]">®</span>
      </span>
    </a>

    <!-- Desktop Menu -->
    <nav class="hidden md:flex items-center gap-6">
      {navItems.map((item) => {
        const isActive = (item.href === "/" && currentPath === "") || (item.href !== "/" && currentPath === item.href);
        return (
          <a
            href={item.href}
            class={`text-xs font-semibold tracking-wider transition-colors ${
              isActive
                ? "text-[#0C0C0C] font-bold border-b-2 border-[#0C0C0C] pb-0.5"
                : "text-[#0C0C0C]/70 hover:text-[#F9452D]"
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Action Button: Capsule pill matching reference -->
    <div class="hidden md:flex items-center">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 pl-4 pr-1.5 py-1.5 rounded-full bg-white border border-[#0C0C0C]/15 text-[#0C0C0C] text-xs font-bold tracking-wide shadow-xs hover:border-[#0C0C0C] hover:shadow-md transition-all group"
      >
        <span>Let's talk</span>
        <span class="w-6 h-6 rounded-full bg-[#0C0C0C] text-white flex items-center justify-center text-xs group-hover:bg-[#F9452D] transition-colors">
          &#8599;
        </span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 rounded-lg text-[#0C0C0C] hover:bg-[#0C0C0C]/5 focus:outline-none"
      aria-label="Toggle Navigation"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 space-y-2 border-t border-[#0C0C0C]/10 bg-[#F8F8FF] shadow-lg">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-md text-sm font-semibold tracking-wider text-[#0C0C0C] hover:text-[#F9452D]"
      >
        {item.name}
      </a>
    ))}
    <a
      href="/contact"
      class="inline-flex w-full items-center justify-between px-4 py-2.5 rounded-full bg-[#0C0C0C] text-white text-xs font-bold"
    >
      <span>Let's talk</span>
      <span class="text-[#F9452D] font-bold">&#8599;</span>
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
