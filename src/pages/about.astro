---
import Layout from '../layouts/Layout.astro';
import MotionWrapper from '../components/MotionWrapper';

const skills = [
  { category: "Frontend", items: ["React", "Astro", "TypeScript", "Next.js", "Tailwind CSS", "Framer Motion", "Vue.js"] },
  { category: "Backend & Systems", items: ["Node.js", "Express", "Go", "PostgreSQL", "Redis", "REST & GraphQL APIs"] },
  { category: "Tools & DevOps", items: ["Git & GitHub", "Docker", "Vercel", "Linux", "CI/CD Workflows", "Vite"] },
  { category: "Design & UX", items: ["Figma", "Design Systems", "Prototyping", "Responsive UI", "Accessibility (a11y)"] },
];

const experiences = [
  {
    role: "Senior Frontend Engineer",
    company: "Tech Horizon Lab",
    period: "2024 — Present",
    description: "Architecting modern web applications with Astro, React, and Tailwind CSS. Implementing design systems and high-throughput real-time web tools."
  },
  {
    role: "Fullstack Developer",
    company: "Studio Digital",
    period: "2022 — 2024",
    description: "Built scalable backend services and responsive client web applications for international clients with focus on performance and usability."
  }
];
---

<Layout title="About Me | Alfarizi">
  <div class="max-w-4xl mx-auto py-8">
    <!-- Header -->
    <MotionWrapper client:load delay={0.1}>
      <p class="text-xs uppercase tracking-widest text-[#F9452D] font-bold mb-2">Introduction</p>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[#0C0C0C] mb-6">About Me</h1>
      <p class="text-lg text-[#0C0C0C]/75 leading-relaxed mb-12">
        I am a passionate software engineer with a deep love for craft, performance, and clean code. I focus on creating responsive, intuitive, and modern web applications that provide real impact.
      </p>
    </MotionWrapper>

    <!-- Bio Card in #0C0C0C Structural Style -->
    <MotionWrapper client:load delay={0.2} className="mb-16">
      <div class="structure-card rounded-2xl p-6 sm:p-8 relative overflow-hidden">
        <h2 class="text-xl font-bold text-white mb-4">Background & Philosophy</h2>
        <div class="space-y-4 text-gray-300 leading-relaxed text-sm sm:text-base">
          <p>
            With years of experience across the entire development stack, I bridge the gap between design concepts and scalable, robust engineering implementations.
          </p>
          <p>
            I care deeply about performance metrics, seamless user experience, and accessible web standards. My toolkit revolves around modern ecosystems like Astro, React, Tailwind CSS, and TypeScript.
          </p>
        </div>
      </div>
    </MotionWrapper>

    <!-- Skills Section -->
    <section class="mb-16">
      <div class="flex items-center gap-3 mb-8">
        <h2 class="text-2xl font-bold text-[#0C0C0C]">Technical Expertise</h2>
        <span class="w-2 h-2 rounded-full bg-[#255031]"></span>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {skills.map((skillGroup, idx) => (
          <MotionWrapper client:visible delay={idx * 0.1}>
            <div class="light-card rounded-2xl p-6 h-full">
              <h3 class="text-[#0C0C0C] font-bold text-base mb-4 flex items-center gap-2.5">
                <!-- Minimal balancing accent with #255031 -->
                <span class="w-1.5 h-4 bg-[#255031] rounded-full"></span>
                {skillGroup.category}
              </h3>
              <div class="flex flex-wrap gap-2">
                {skillGroup.items.map((item) => (
                  <span class="text-xs font-mono px-3 py-1.5 rounded-lg bg-[#F8F8FF] text-[#0C0C0C] border border-[#0C0C0C]/10 shadow-xs">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </MotionWrapper>
        ))}
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-[#0C0C0C] mb-8">Experience & Journey</h2>
      <div class="space-y-6">
        {experiences.map((exp, idx) => (
          <MotionWrapper client:visible delay={idx * 0.15}>
            <div class="light-card rounded-2xl p-6 relative">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                <h3 class="text-lg font-bold text-[#0C0C0C]">{exp.role}</h3>
                <span class="text-xs font-mono text-[#0C0C0C] bg-[#0C0C0C]/5 px-2.5 py-1 rounded-md border border-[#0C0C0C]/10 w-fit">
                  {exp.period}
                </span>
              </div>
              <p class="text-sm font-medium text-[#F9452D] mb-3">{exp.company}</p>
              <p class="text-sm text-[#0C0C0C]/75 leading-relaxed">{exp.description}</p>
            </div>
          </MotionWrapper>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div class="text-center pt-8">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-[#F9452D] hover:bg-[#E23821] text-white font-medium shadow-lg shadow-[#F9452D]/20 transition-all group"
      >
        <span>Get in Touch With Me</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>
  </div>
</Layout>
