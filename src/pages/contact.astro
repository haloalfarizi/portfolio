---
import Layout from '../layouts/Layout.astro';
import MotionWrapper from '../components/MotionWrapper';
---

<Layout title="Contact | Alfarizi">
  <div class="max-w-4xl mx-auto py-8">
    <MotionWrapper client:load delay={0.1}>
      <p class="text-xs uppercase tracking-widest text-[#F9452D] font-bold mb-2">Reach Out</p>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[#0C0C0C] mb-6">Let's Connect</h1>
      <p class="text-lg text-[#0C0C0C]/75 leading-relaxed mb-12">
        Have an exciting project, job opportunity, or just want to chat about tech? Fill out the form below or send me an email directly.
      </p>
    </MotionWrapper>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
      <!-- Contact Information (2 cols) -->
      <MotionWrapper client:load delay={0.2} className="lg:col-span-2 space-y-6">
        <!-- Structural Dark Card (#0C0C0C) -->
        <div class="structure-card rounded-2xl p-6">
          <h2 class="text-lg font-bold text-white mb-4">Contact Details</h2>
          <div class="space-y-4 text-sm text-gray-300">
            <div>
              <p class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-1">Email</p>
              <a href="mailto:hello@alfarizi.dev" class="text-[#F9452D] hover:underline font-mono">
                hello@alfarizi.dev
              </a>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-1">Location</p>
              <p class="text-white">Jakarta, Indonesia (UTC+7)</p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-1">Work Availability</p>
              <!-- Minimal balancing accent with #255031 -->
              <p class="text-[#7dd395] font-medium flex items-center gap-2 pt-0.5">
                <span class="w-2 h-2 rounded-full bg-[#52b772] animate-pulse"></span>
                Open to Remote & Full-time Roles
              </p>
            </div>
          </div>
        </div>

        <div class="light-card rounded-2xl p-6">
          <h2 class="text-lg font-bold text-[#0C0C0C] mb-3">Connect Online</h2>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="https://github.com/haloalfarizi" target="_blank" rel="noreferrer" class="text-[#0C0C0C]/80 hover:text-[#F9452D] flex items-center gap-2 transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0C0C0C]"></span>
                GitHub: @haloalfarizi
              </a>
            </li>
            <li>
              <a href="https://linkedin.com" target="_blank" rel="noreferrer" class="text-[#0C0C0C]/80 hover:text-[#F9452D] flex items-center gap-2 transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0C0C0C]"></span>
                LinkedIn Profile
              </a>
            </li>
            <li>
              <a href="https://twitter.com" target="_blank" rel="noreferrer" class="text-[#0C0C0C]/80 hover:text-[#F9452D] flex items-center gap-2 transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0C0C0C]"></span>
                X / Twitter
              </a>
            </li>
          </ul>
        </div>
      </MotionWrapper>

      <!-- Contact Form (3 cols) -->
      <MotionWrapper client:load delay={0.3} className="lg:col-span-3">
        <form
          id="contact-form"
          class="light-card rounded-2xl p-6 sm:p-8 space-y-5"
        >
          <div>
            <label for="name" class="block text-sm font-semibold text-[#0C0C0C] mb-1.5">
              Full Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Jane Doe"
              class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#0C0C0C]/15 text-[#0C0C0C] placeholder-[#0C0C0C]/40 focus:outline-none focus:border-[#F9452D] focus:ring-1 focus:ring-[#F9452D] transition-all text-sm shadow-xs"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-[#0C0C0C] mb-1.5">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="jane@example.com"
              class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#0C0C0C]/15 text-[#0C0C0C] placeholder-[#0C0C0C]/40 focus:outline-none focus:border-[#F9452D] focus:ring-1 focus:ring-[#F9452D] transition-all text-sm shadow-xs"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-[#0C0C0C] mb-1.5">
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="Project Inquiry / Opportunity"
              class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#0C0C0C]/15 text-[#0C0C0C] placeholder-[#0C0C0C]/40 focus:outline-none focus:border-[#F9452D] focus:ring-1 focus:ring-[#F9452D] transition-all text-sm shadow-xs"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-[#0C0C0C] mb-1.5">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Tell me about your project or what you have in mind..."
              class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#0C0C0C]/15 text-[#0C0C0C] placeholder-[#0C0C0C]/40 focus:outline-none focus:border-[#F9452D] focus:ring-1 focus:ring-[#F9452D] transition-all text-sm resize-none shadow-xs"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#F9452D] hover:bg-[#E23821] text-white font-medium shadow-lg shadow-[#F9452D]/20 transition-all text-sm flex items-center justify-center gap-2 group cursor-pointer"
          >
            <span>Send Message</span>
            <svg class="w-4 h-4 fill-none stroke-current stroke-2 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>
      </MotionWrapper>
    </div>
  </div>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        alert("Thank you! Your message has been sent successfully.");
        form.reset();
      });
    }
  </script>
</Layout>
