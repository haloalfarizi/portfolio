---
import Layout from "../layouts/Layout.astro";
import HeroMotion from "../components/HeroMotion";
import Numbers from "../components/Numbers";
import FeaturedProjects from "../components/FeaturedProjects";
import MotionWrapper from "../components/MotionWrapper";
---

<Layout
  title="Alfarizi | Fullstack Engineer & Creative Developer"
  fullWidth={true}
>
  <!-- Full-Width Edge-to-Edge Hero Section -->
  <section class="w-full">
    <HeroMotion client:load />
  </section>

  <!-- Contained Lower Sections -->
  <div class="max-w-[1920px] mx-auto px-6 sm:px-12 lg:px-16">
    <!-- Numbers Section (Directly Below Hero) -->
    <Numbers client:visible />

    <!-- Dedicated Featured Projects Section -->
    <FeaturedProjects client:visible />

    <!-- About Teaser / Call to action in #0C0C0C Structure Section -->
    <section class="pb-24 sm:pb-32">
      <MotionWrapper client:visible delay={0.2} className="w-full">
        <div
          class="rounded-3xl p-8 sm:p-12 relative overflow-hidden bg-[#0C0C0C] text-[#F8F8FF] border border-white/10 shadow-2xl"
        >
          <div
            class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#F9452D]/10 rounded-full blur-3xl pointer-events-none"
          >
          </div>

          <div class="max-w-2xl relative z-10">
            <p
              class="text-xs uppercase tracking-widest text-[#F9452D] font-bold mb-3"
            >
              Collaboration
            </p>
            <h2
              class="text-2xl sm:text-4xl font-extrabold text-white mb-4 tracking-tight"
            >
              Let's collaborate on your next vision.
            </h2>
            <p class="text-gray-300 mb-8 leading-relaxed text-base sm:text-lg">
              Whether you need modern frontend architecture, robust backend
              services, or intuitive design systems, feel free to reach out.
            </p>
            <div class="flex flex-wrap gap-4">
              <a
                href="/contact"
                class="px-6 py-3.5 rounded-xl bg-[#F9452D] hover:bg-[#E23821] text-white font-medium shadow-lg shadow-[#F9452D]/25 transition-all flex items-center gap-2 group"
              >
                <span>Start a Conversation</span>
                <span class="group-hover:translate-x-1 transition-transform"
                  >&rarr;</span
                >
              </a>
              <a
                href="/about"
                class="px-6 py-3.5 rounded-xl border border-white/20 hover:bg-white/10 text-white font-medium transition-colors"
              >
                Learn More About Me
              </a>
            </div>
          </div>
        </div>
      </MotionWrapper>
    </section>
  </div>
</Layout>
