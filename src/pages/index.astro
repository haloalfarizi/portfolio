---
import Layout from '../layouts/Layout.astro';
import HeroMotion from '../components/HeroMotion';
import ProjectCard from '../components/ProjectCard';
import MotionWrapper from '../components/MotionWrapper';
import { projectsData } from '../data/projects';

const featuredProjects = projectsData.filter((p) => p.featured);
---

<Layout title="Alfarizi | Fullstack Engineer & Creative Developer">
  <!-- Hero Section with Framer Motion -->
  <section class="w-full mb-16 sm:mb-24">
    <HeroMotion client:load />
  </section>

  <!-- Featured Projects Section -->
  <section class="mt-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-xs uppercase tracking-widest text-[#F9452D] font-bold mb-2">Portfolio</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0C0C0C]">Featured Projects</h2>
      </div>
      <a
        href="/projects"
        class="text-sm font-semibold text-[#0C0C0C] hover:text-[#F9452D] transition-colors inline-flex items-center gap-1.5 group"
      >
        <span>View all projects</span>
        <span class="text-[#F9452D] group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProjects.map((project, index) => (
        <ProjectCard client:visible project={project} index={index} />
      ))}
    </div>
  </section>

  <!-- About Teaser / Call to action in #0C0C0C Structure Section -->
  <section class="mt-28">
    <MotionWrapper client:visible delay={0.2} className="w-full">
      <div class="rounded-3xl p-8 sm:p-12 relative overflow-hidden bg-[#0C0C0C] text-[#F8F8FF] border border-white/10 shadow-2xl">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#F9452D]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-2xl relative z-10">
          <p class="text-xs uppercase tracking-widest text-[#F9452D] font-bold mb-3">Collaboration</p>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-4 tracking-tight">
            Let's collaborate on your next vision.
          </h2>
          <p class="text-gray-300 mb-8 leading-relaxed text-base sm:text-lg">
            Whether you need modern frontend architecture, robust backend services, or intuitive design systems, feel free to reach out.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="/contact"
              class="px-6 py-3.5 rounded-xl bg-[#F9452D] hover:bg-[#E23821] text-white font-medium shadow-lg shadow-[#F9452D]/25 transition-all flex items-center gap-2 group"
            >
              <span>Start a Conversation</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
            <a
              href="/about"
              class="px-6 py-3.5 rounded-xl border border-white/20 hover:bg-white/10 text-white font-medium transition-colors"
            >
              Learn More About Me
            </a>
          </div>
        </div>
      </div>
    </MotionWrapper>
  </section>
</Layout>
